{
  "name": "picture-descriptor",
  "version": "0.2.0",
  "description": "Describes images using AI via sub-agent sessions. Tiers: local (llamaswap/gemma4), remote-free (github-copilot/gpt-5-mini), remote-paid (opencode-go/qwen3.5-plus). Formats: natural or structured JSON.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension",
    "vision",
    "image-description"
  ],
  "scripts": {
    "validate": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "dependencies": {
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typescript": "^5.3.0",
    "vitest": "^4.1.6"
  },
  "pi": {
    "extensions": [
      "./src/picture-descriptor.ts"
    ]
  }
}
